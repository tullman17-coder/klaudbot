# Copy to .env.local on the machine that runs Next. Never commit the copy.

# Klaud harness origin (rein serve). Loopback for a single host.
KLAUD_ORIGIN=http://127.0.0.1:4317

# Next bind. Keep loopback unless an edge proxy terminates TLS in front.
KLAUD_BIND_HOST=127.0.0.1
KLAUD_PORT=4322
KLAUD_SANDBOX_ORIGIN=http://127.0.0.1:4322

# Optional. Only if you run Jev behind Authelia. Leave unset otherwise.
# TYPESAFE_API_KEY=
